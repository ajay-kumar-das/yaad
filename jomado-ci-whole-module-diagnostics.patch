--- a/.github/workflows/ios-ci.yml
+++ b/.github/workflows/ios-ci.yml
@@ -17,7 +17,7 @@
 jobs:
   verify:
     runs-on: macos-latest
-    timeout-minutes: 35
+    timeout-minutes: 50
 
     steps:
       - name: Checkout
@@ -46,6 +46,87 @@
       - name: Generate Xcode project
         run: xcodegen generate --spec project.yml
 
+      - name: Whole-module compiler diagnostics
+        id: compiler_diagnostics
+        shell: bash
+        run: |
+          set -u
+          set -o pipefail
+          set +e
+
+          rm -f liveactivity-diagnostic.log app-diagnostic.log
+
+          echo "===== JomadoLiveActivity whole-module diagnostics ====="
+          xcodebuild \
+            -quiet \
+            -project Jomado.xcodeproj \
+            -target JomadoLiveActivity \
+            -configuration Debug \
+            -sdk iphonesimulator \
+            CODE_SIGNING_ALLOWED=NO \
+            SWIFT_COMPILATION_MODE=wholemodule \
+            SWIFT_STRICT_CONCURRENCY=complete \
+            COMPILER_INDEX_STORE_ENABLE=NO \
+            build 2>&1 | tee liveactivity-diagnostic.log
+          LIVE_STATUS=${PIPESTATUS[0]}
+
+          echo
+          echo "===== Jomado app whole-module diagnostics ====="
+          xcodebuild \
+            -quiet \
+            -project Jomado.xcodeproj \
+            -target Jomado \
+            -configuration Debug \
+            -sdk iphonesimulator \
+            CODE_SIGNING_ALLOWED=NO \
+            SWIFT_COMPILATION_MODE=wholemodule \
+            SWIFT_STRICT_CONCURRENCY=complete \
+            COMPILER_INDEX_STORE_ENABLE=NO \
+            build 2>&1 | tee app-diagnostic.log
+          APP_STATUS=${PIPESTATUS[0]}
+
+          echo
+          echo "===== Consolidated compiler diagnostics ====="
+          DIAGNOSTICS="$(
+            grep -hE               'error:|warning:|fatal error:|risks causing data races|unable to type-check|BUILD FAILED'               liveactivity-diagnostic.log app-diagnostic.log || true
+          )"
+
+          if [[ -n "$DIAGNOSTICS" ]]; then
+            printf '%s\n' "$DIAGNOSTICS"
+          else
+            echo "No compiler errors or warnings found."
+          fi
+
+          {
+            echo "## Xcode whole-module diagnostics"
+            echo
+            echo "- JomadoLiveActivity exit status: $LIVE_STATUS"
+            echo "- Jomado app exit status: $APP_STATUS"
+            echo
+            echo '```text'
+            if [[ -n "$DIAGNOSTICS" ]]; then
+              printf '%s\n' "$DIAGNOSTICS"
+            else
+              echo "No compiler errors or warnings found."
+            fi
+            echo '```'
+          } >> "$GITHUB_STEP_SUMMARY"
+
+          if [[ "$LIVE_STATUS" -ne 0 || "$APP_STATUS" -ne 0 ]]; then
+            exit 1
+          fi
+
+      - name: Upload compiler diagnostic logs
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: xcode-compiler-diagnostics
+          path: |
+            liveactivity-diagnostic.log
+            app-diagnostic.log
+          if-no-files-found: ignore
+          retention-days: 7
+
       - name: Build app and Live Activity
         run: |
           xcodebuild \
